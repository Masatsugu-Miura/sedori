# Discord Developer Portal → Bot → Reset Token で取得
DISCORD_TOKEN=
# 任意：スラッシュコマンドをすぐ使えるようにしたいサーバーのID（未設定ならグローバル登録＝反映に最大1時間）
GUILD_ID=
# 任意：コードを貼るだけで自動反応させるチャンネルIDをカンマ区切りで（未設定なら全チャンネル）
AUTO_REPLY_CHANNELS=
# 任意：テキストコマンドの接頭辞
COMMAND_PREFIX=!zaiko
# 任意：stores.json の場所（Docker でボリュームに出すときなど）
# STORES_FILE=/data/stores.json
# 任意：コードだけ貼ったときの検索範囲。all=全国（既定） / local=地元（stores.json の home_regions）
AUTO_REPLY_SCOPE=all
# 任意：地元検索のテキストコマンド接頭辞
LOCAL_PREFIX=!local
# 任意：scripts/webhook_test.py で結果を投稿する先（bot なしの動作確認用）
DISCORD_WEBHOOK_URL=
