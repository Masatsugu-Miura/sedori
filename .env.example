# Discord Developer Portal → Bot → Reset Token で取得
DISCORD_TOKEN=
# 任意：スラッシュコマンドをすぐ使えるようにしたいサーバーのID（未設定ならグローバル登録＝反映に最大1時間）
GUILD_ID=
# 任意：コードを貼るだけで自動反応させるチャンネルIDをカンマ区切りで（未設定なら全チャンネル）
AUTO_REPLY_CHANNELS=
# 任意：テキストコマンドの接頭辞
COMMAND_PREFIX=!zaiko
# 任意：stores.json の場所（Docker でボリュームに出すときなど）
# STORES_FILE=/data/stores.json
# 任意：地域を指定しなかったときの検索範囲。local=地元（stores.json の home_regions＝愛知・京都、既定） / all=全国
DEFAULT_SCOPE=local
# 任意：地元検索のテキストコマンド接頭辞
LOCAL_PREFIX=!local
# 任意：scripts/webhook_test.py で結果を投稿する先（bot なしの動作確認用）
DISCORD_WEBHOOK_URL=
# 任意：日販系（ほんらぶ対応店）の在庫連携が復旧したかを毎日チェックする時刻（日本時間、既定 12 時）。0 で無効化は WATCH_ENABLED=0
WATCH_HOUR=12
WATCH_ENABLED=1
# 任意：監視の通知先チャンネルID（未設定なら DISCORD_WEBHOOK_URL に投稿）
NOTIFY_CHANNEL_ID=
# 任意：書店サイトへ 1 リクエスト送るごとのランダム待機（秒）。負荷と機械的アクセスの目立ちを抑える。既定 0.3〜1.2
SCRAPE_DELAY_MIN=0.3
SCRAPE_DELAY_MAX=1.2
# 任意：カーリル（calil.jp）の API キー。書店在庫情報プロジェクト（版元ドットコム）の店舗在庫取得に使う。
# 未設定なら版元ドットコムのページに埋め込まれた公開キーを使う。自分のキーは calil.jp で無料登録できる
CALIL_APPKEY=
# 任意：Amazon SP-API（出品者アカウントの自分用アプリ）。3 つ揃うと Amazon 価格を SP-API で取る（確実・確認ページの影響なし）
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
# 任意：Keepa の API キー。あれば波形グラフを公式 API（api.keepa.com/graphimage）から取る。無ければ graph.keepa.com の画像を使う
KEEPA_API_KEY=
